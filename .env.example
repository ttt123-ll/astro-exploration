# ================= 站点基础 =================
NODE_ENV=production
PORT=3000
APP_VERSION=1.1.0

# ================= 时区 =================
# 全站统一时区；MySQL 会话也按此偏移设置
TZ=Asia/Shanghai
TZ_OFFSET=+08:00

# ================= 数据库 =================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=astro
DB_USER=astro
# 必填：请改成你自己的强密码
DB_PASSWORD=

# ================= 安全（必填，务必修改） =================
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=7d
# 反向代理启用 HTTPS 后设为 1
COOKIE_SECURE=0
# 跨域白名单；同源部署留空即可
CORS_ORIGINS=

# ================= 初始管理员 =================
# 留空则首次启动随机生成并打印在日志里
ADMIN_USER=admin
ADMIN_PASSWORD=

# ================= 限流 =================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
RATE_LIMIT_AUTH_MAX=20

# ================= AI 问答（可选） =================
# 留空 = 使用内置天文知识库（27 条规则，离线可用）
# 填写后 = 自动调用真实大模型（OpenAI 兼容接口）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# ================= Docker 部署 =================
HOST_PORT=3000
SITE_URL=http://localhost:3000
MYSQL_ROOT_PASSWORD=